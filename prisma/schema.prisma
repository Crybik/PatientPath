generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PATIENT
  DOCTOR
  SPECIALIST
  LAB_STAFF
  PHARMACY_STAFF

  @@map("user_role")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  SCHEDULED
  FORWARDED
  REJECTED
  IN_PROGRESS
  COMPLETED

  @@map("referral_status")
}

enum ReferralEventType {
  CREATED
  ACCEPTED
  SCHEDULED
  FORWARDED
  REJECTED
  IN_PROGRESS
  COMPLETED
  STATUS_UPDATED
  INFORMATION_REQUESTED
  FEEDBACK_ADDED
  ATTACHMENT_ADDED

  @@map("referral_event_type")
}

model User {
  id                     Int             @id @default(autoincrement())
  username               String          @unique @db.VarChar(64)
  passwordHash           String          @map("password_hash")
  plainPassword          String?         @map("plain_password") @db.VarChar(200)
  email                  String?         @db.VarChar(120)
  isActive               Boolean         @default(true) @map("is_active")
  role                   UserRole        @default(PATIENT)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  patientProfile         PatientProfile?
  staffProfile           StaffProfile?
  createdReferrals       Referral[]      @relation("CreatedReferrals")
  specialistReferrals    Referral[]      @relation("CurrentSpecialistReferrals")
  referralEvents         ReferralEvent[] @relation("ReferralEventActor")
  requestedLabTests      LabTest[]       @relation("RequestedLabTests")
  processedLabTests      LabTest[]       @relation("ProcessedLabTests")
  createdPrescriptions   Prescription[]  @relation("CreatedPrescriptions")
  dispensedPrescriptions Prescription[]  @relation("DispensedPrescriptions")
  uploadedAttachments    Attachment[]    @relation("UploadedAttachments")
  notifications          Notification[]
  reports                Report[]
  passwordResetTokens    PasswordResetToken[]
  supportRequests        SupportRequest[]

  @@map("users")
}

model PatientProfile {
  id            Int            @id @default(autoincrement())
  userId        Int            @unique @map("user_id")
  fullName      String         @map("full_name") @db.VarChar(160)
  uniId         String         @unique @map("uni_id") @db.VarChar(32)
  gender        Gender
  dob           DateTime       @db.Date
  phoneNumber   String?        @map("phone_number") @db.VarChar(32)
  faculty       String?        @db.VarChar(80)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  visits        PatientVisit[]
  referrals     Referral[]
  labTests      LabTest[]
  prescriptions Prescription[]

  @@map("patient_profiles")
}

model StaffProfile {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique @map("user_id")
  fullName       String    @map("full_name") @db.VarChar(160)
  title          String    @db.VarChar(120)
  specialization String?   @db.VarChar(120)
  department     String?   @db.VarChar(120)
  labSection     String?   @map("lab_section") @db.VarChar(120)
  hospitalId     Int?      @map("hospital_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital       Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@map("staff_profiles")
}

model Hospital {
  id        Int            @id @default(autoincrement())
  name      String         @db.VarChar(180)
  shortName String         @unique @map("short_name") @db.VarChar(48)
  city      String         @db.VarChar(80)
  logoPath  String?        @map("logo_path") @db.VarChar(240)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  clinics   Clinic[]
  staff     StaffProfile[]
  referrals Referral[]

  @@map("hospitals")
}

model Clinic {
  id          Int                      @id @default(autoincrement())
  hospitalId  Int                      @map("hospital_id")
  name        String                   @db.VarChar(120)
  slug        String                   @db.VarChar(80)
  description String                   @db.VarChar(240)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz()
  hospital    Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  slots       ClinicAvailabilitySlot[]
  referrals   Referral[]
  fromEvents  ReferralEvent[]          @relation("ReferralEventFromClinic")
  toEvents    ReferralEvent[]          @relation("ReferralEventToClinic")

  @@unique([hospitalId, slug])
  @@map("clinics")
}

model ClinicAvailabilitySlot {
  id          Int             @id @default(autoincrement())
  clinicId    Int             @map("clinic_id")
  startsAt    DateTime        @map("starts_at") @db.Timestamptz()
  endsAt      DateTime        @map("ends_at") @db.Timestamptz()
  capacity    Int             @default(1)
  bookedCount Int             @default(0) @map("booked_count")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  referrals   Referral[]
  events      ReferralEvent[]

  @@unique([clinicId, startsAt])
  @@map("clinic_availability_slots")
}

model PatientVisit {
  id           Int            @id @default(autoincrement())
  patientId    Int            @map("patient_id")
  hospitalName String         @map("hospital_name") @db.VarChar(180)
  clinicName   String         @map("clinic_name") @db.VarChar(120)
  doctorName   String         @map("doctor_name") @db.VarChar(160)
  visitedAt    DateTime       @map("visited_at") @db.Date
  summary      String         @db.VarChar(240)
  notes        String         @db.Text
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_visits")
}

model Referral {
  id                  Int                     @id @default(autoincrement())
  patientId           Int                     @map("patient_id")
  createdById         Int                     @map("created_by_id")
  currentSpecialistId Int?                    @map("current_specialist_id")
  hospitalId          Int                     @map("hospital_id")
  clinicId            Int                     @map("clinic_id")
  slotId              Int?                    @map("slot_id")
  status              ReferralStatus          @default(PENDING)
  doctorNote          String                  @map("doctor_note") @db.Text
  specialistNote      String?                 @map("specialist_note") @db.Text
  rejectionReason     String?                 @map("rejection_reason") @db.Text
  feedback            String?                 @db.Text
  scheduledAt         DateTime?               @map("scheduled_at") @db.Timestamptz()
  acceptedAt          DateTime?               @map("accepted_at") @db.Timestamptz()
  completedAt         DateTime?               @map("completed_at") @db.Timestamptz()
  feedbackAt          DateTime?               @map("feedback_at") @db.Timestamptz()
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz()
  patient             PatientProfile          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy           User                    @relation("CreatedReferrals", fields: [createdById], references: [id], onDelete: Restrict)
  currentSpecialist   User?                   @relation("CurrentSpecialistReferrals", fields: [currentSpecialistId], references: [id], onDelete: SetNull)
  hospital            Hospital                @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  clinic              Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  slot                ClinicAvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  events              ReferralEvent[]
  labTests            LabTest[]
  prescriptions       Prescription[]
  attachments         Attachment[]

  @@map("referrals")
}

model ReferralEvent {
  id           Int                     @id @default(autoincrement())
  referralId   Int                     @map("referral_id")
  actorId      Int?                    @map("actor_id")
  type         ReferralEventType
  note         String?                 @db.Text
  fromClinicId Int?                    @map("from_clinic_id")
  toClinicId   Int?                    @map("to_clinic_id")
  slotId       Int?                    @map("slot_id")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  referral     Referral                @relation(fields: [referralId], references: [id], onDelete: Cascade)
  actor        User?                   @relation("ReferralEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  fromClinic   Clinic?                 @relation("ReferralEventFromClinic", fields: [fromClinicId], references: [id], onDelete: SetNull)
  toClinic     Clinic?                 @relation("ReferralEventToClinic", fields: [toClinicId], references: [id], onDelete: SetNull)
  slot         ClinicAvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@map("referral_events")
}

model LabTest {
  id            Int            @id @default(autoincrement())
  referralId    Int?           @map("referral_id")
  patientId     Int            @map("patient_id")
  requestedById Int            @map("requested_by_id")
  labStaffId    Int?           @map("lab_staff_id")
  testType      String         @db.VarChar(120)
  status        String         @default("PENDING") @db.VarChar(32)
  result        String?        @db.Text
  requestDate   DateTime       @default(now()) @map("request_date") @db.Timestamptz()
  resultDate    DateTime?      @map("result_date") @db.Timestamptz()
  referral      Referral?      @relation(fields: [referralId], references: [id], onDelete: SetNull)
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedBy   User           @relation("RequestedLabTests", fields: [requestedById], references: [id], onDelete: Restrict)
  labStaff      User?          @relation("ProcessedLabTests", fields: [labStaffId], references: [id], onDelete: SetNull)

  @@map("lab_tests")
}

model Prescription {
  id              Int            @id @default(autoincrement())
  referralId      Int?           @map("referral_id")
  patientId       Int            @map("patient_id")
  requestedById   Int            @map("requested_by_id")
  pharmacyStaffId Int?           @map("pharmacy_staff_id")
  medicationName  String         @db.VarChar(120)
  dosage          String         @db.VarChar(80)
  frequency       String         @db.VarChar(80)
  duration        String         @db.VarChar(80)
  isDispensed     Boolean        @default(false) @map("is_dispensed")
  dispensedDate   DateTime?      @map("dispensed_date") @db.Timestamptz()
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  referral        Referral?      @relation(fields: [referralId], references: [id], onDelete: SetNull)
  patient         PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedBy     User           @relation("CreatedPrescriptions", fields: [requestedById], references: [id], onDelete: Restrict)
  pharmacyStaff   User?          @relation("DispensedPrescriptions", fields: [pharmacyStaffId], references: [id], onDelete: SetNull)

  @@map("prescriptions")
}

model Attachment {
  id                   Int       @id @default(autoincrement())
  referralId           Int       @map("referral_id")
  uploadedById         Int?      @map("uploaded_by_id")
  fileName             String    @db.VarChar(240)
  fileType             String    @db.VarChar(120)
  fileSize             Int?      @map("file_size")
  storageProvider      String    @default("R2") @map("storage_provider") @db.VarChar(40)
  status               String    @default("UPLOADED") @db.VarChar(40)
  r2Key                String?   @map("r2_key") @db.VarChar(512)
  cloudflareImageId    String?   @map("cloudflare_image_id") @db.VarChar(128)
  cloudflareVariantUrl String?   @map("cloudflare_variant_url") @db.Text
  uploadDate           DateTime  @default(now()) @map("upload_date") @db.Timestamptz()
  referral             Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  uploadedBy           User?     @relation("UploadedAttachments", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@map("attachments")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  message   String   @db.Text
  type      String   @db.VarChar(48)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Report {
  id            Int      @id @default(autoincrement())
  generatedById Int      @map("generated_by_id")
  reportType    String   @db.VarChar(80)
  data          String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  generatedBy   User     @relation(fields: [generatedById], references: [id], onDelete: Restrict)

  @@map("reports")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model SupportRequest {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  name        String    @db.VarChar(160)
  email       String    @db.VarChar(160)
  role        String?   @db.VarChar(80)
  category    String    @default("Technical Issue") @db.VarChar(80)
  subject     String    @db.VarChar(180)
  message     String    @db.Text
  status      String    @default("OPEN") @db.VarChar(40)
  adminNote   String?   @map("admin_note") @db.Text
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("support_requests")
}

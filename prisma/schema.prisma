generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PATIENT
  DOCTOR
  SPECIALIST

  @@map("user_role")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  FORWARDED

  @@map("referral_status")
}

enum ReferralEventType {
  CREATED
  ACCEPTED
  FORWARDED

  @@map("referral_event_type")
}

model User {
  id                  Int             @id @default(autoincrement())
  username            String          @unique @db.VarChar(64)
  passwordHash        String          @map("password_hash")
  role                UserRole        @default(PATIENT)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  patientProfile      PatientProfile?
  staffProfile        StaffProfile?
  createdReferrals    Referral[]      @relation("CreatedReferrals")
  specialistReferrals Referral[]      @relation("CurrentSpecialistReferrals")
  referralEvents      ReferralEvent[] @relation("ReferralEventActor")

  @@map("users")
}

model PatientProfile {
  id        Int            @id @default(autoincrement())
  userId    Int            @unique @map("user_id")
  fullName  String         @map("full_name") @db.VarChar(160)
  uniId     String         @unique @map("uni_id") @db.VarChar(32)
  gender    Gender
  dob       DateTime       @db.Date
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  visits    PatientVisit[]
  referrals Referral[]

  @@map("patient_profiles")
}

model StaffProfile {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique @map("user_id")
  fullName   String    @map("full_name") @db.VarChar(160)
  title      String    @db.VarChar(120)
  hospitalId Int?      @map("hospital_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@map("staff_profiles")
}

model Hospital {
  id        Int            @id @default(autoincrement())
  name      String         @db.VarChar(180)
  shortName String         @unique @map("short_name") @db.VarChar(48)
  city      String         @db.VarChar(80)
  logoPath  String?        @map("logo_path") @db.VarChar(240)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  clinics   Clinic[]
  staff     StaffProfile[]
  referrals Referral[]

  @@map("hospitals")
}

model Clinic {
  id          Int                      @id @default(autoincrement())
  hospitalId  Int                      @map("hospital_id")
  name        String                   @db.VarChar(120)
  slug        String                   @db.VarChar(80)
  description String                   @db.VarChar(240)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz()
  hospital    Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  slots       ClinicAvailabilitySlot[]
  referrals   Referral[]
  fromEvents  ReferralEvent[]          @relation("ReferralEventFromClinic")
  toEvents    ReferralEvent[]          @relation("ReferralEventToClinic")

  @@unique([hospitalId, slug])
  @@map("clinics")
}

model ClinicAvailabilitySlot {
  id          Int             @id @default(autoincrement())
  clinicId    Int             @map("clinic_id")
  startsAt    DateTime        @map("starts_at") @db.Timestamptz()
  endsAt      DateTime        @map("ends_at") @db.Timestamptz()
  capacity    Int             @default(1)
  bookedCount Int             @default(0) @map("booked_count")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  referrals   Referral[]
  events      ReferralEvent[]

  @@unique([clinicId, startsAt])
  @@map("clinic_availability_slots")
}

model PatientVisit {
  id           Int            @id @default(autoincrement())
  patientId    Int            @map("patient_id")
  hospitalName String         @map("hospital_name") @db.VarChar(180)
  clinicName   String         @map("clinic_name") @db.VarChar(120)
  doctorName   String         @map("doctor_name") @db.VarChar(160)
  visitedAt    DateTime       @map("visited_at") @db.Date
  summary      String         @db.VarChar(240)
  notes        String         @db.Text
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_visits")
}

model Referral {
  id                  Int                     @id @default(autoincrement())
  patientId           Int                     @map("patient_id")
  createdById         Int                     @map("created_by_id")
  currentSpecialistId Int?                    @map("current_specialist_id")
  hospitalId          Int                     @map("hospital_id")
  clinicId            Int                     @map("clinic_id")
  slotId              Int?                    @map("slot_id")
  status              ReferralStatus          @default(PENDING)
  doctorNote          String                  @map("doctor_note") @db.Text
  specialistNote      String?                 @map("specialist_note") @db.Text
  scheduledAt         DateTime?               @map("scheduled_at") @db.Timestamptz()
  acceptedAt          DateTime?               @map("accepted_at") @db.Timestamptz()
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz()
  patient             PatientProfile          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy           User                    @relation("CreatedReferrals", fields: [createdById], references: [id], onDelete: Restrict)
  currentSpecialist   User?                   @relation("CurrentSpecialistReferrals", fields: [currentSpecialistId], references: [id], onDelete: SetNull)
  hospital            Hospital                @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  clinic              Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  slot                ClinicAvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  events              ReferralEvent[]

  @@map("referrals")
}

model ReferralEvent {
  id           Int                     @id @default(autoincrement())
  referralId   Int                     @map("referral_id")
  actorId      Int?                    @map("actor_id")
  type         ReferralEventType
  note         String?                 @db.Text
  fromClinicId Int?                    @map("from_clinic_id")
  toClinicId   Int?                    @map("to_clinic_id")
  slotId       Int?                    @map("slot_id")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  referral     Referral                @relation(fields: [referralId], references: [id], onDelete: Cascade)
  actor        User?                   @relation("ReferralEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  fromClinic   Clinic?                 @relation("ReferralEventFromClinic", fields: [fromClinicId], references: [id], onDelete: SetNull)
  toClinic     Clinic?                 @relation("ReferralEventToClinic", fields: [toClinicId], references: [id], onDelete: SetNull)
  slot         ClinicAvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@map("referral_events")
}
